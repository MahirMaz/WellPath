# Copy this file to ".env" and fill in the real values.
# The real ".env" is never uploaded to GitHub (it holds secrets).

# --- Database ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your-mysql-password-here
DB_NAME=wellpath_health
# Set DB_SSL=true when using a hosted MySQL provider (Aiven, Railway, etc.).
# Leave it unset/false for a local MySQL.
DB_SSL=false
# Only set this to false if the host uses a self-signed cert and connection fails.
DB_SSL_REJECT_UNAUTHORIZED=true

# --- Auth ---
JWT_SECRET=your-jwt-secret-here

# --- Server ---
PORT=3000
# Comma-separated list of allowed frontend origins for production, e.g.
# CORS_ORIGINS=https://wellpath.vercel.app,https://www.your-domain.com
# Localhost is always allowed automatically.
CORS_ORIGINS=

# --- AI (Groq) ---
# A single key, or several comma-separated keys from separate Groq accounts
# to multiply the free daily quota.
GROQ_API_KEY=your-groq-api-key-here
# GROQ_API_KEYS=key1,key2
