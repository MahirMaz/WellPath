# Copy this file to ".env" on each machine and fill in the real values.
# The real ".env" is never uploaded to GitHub (it holds secrets).
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your-mysql-password-here
DB_NAME=wellpath_health
JWT_SECRET=your-jwt-secret-here
PORT=3000
GROQ_API_KEY=your-groq-api-key-here
