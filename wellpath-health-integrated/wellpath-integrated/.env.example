# Frontend (Vite) environment. Copy to ".env" and adjust as needed.
# Vite only exposes variables prefixed with VITE_ to the browser.

# Base URL of the backend API.
# - Local dev: leave unset; Vite proxies /api to the local backend (see vite.config.js).
# - Production: set to your deployed backend, e.g.
#   VITE_API_URL=https://wellpath-api.onrender.com/api
VITE_API_URL=/api
